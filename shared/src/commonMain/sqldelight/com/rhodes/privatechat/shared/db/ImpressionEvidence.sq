-- T81a 印象证据链：一个印象由哪些记忆支撑。
-- 证据与印象分表存放：印象主体可能被合并/改写，证据行只记录「当时引用了哪条记忆、权重多少」，
-- 记忆被删除后由 deleteOrphans/deleteByMemory 清理，不靠外键（SQLite 默认不启用外键）。
CREATE TABLE IF NOT EXISTS memory_impression_evidence (
  impressionId INTEGER NOT NULL, memoryId INTEGER NOT NULL,
  weight REAL NOT NULL DEFAULT 1.0, createdAt INTEGER NOT NULL DEFAULT 0,
  PRIMARY KEY(impressionId, memoryId)
);
CREATE INDEX IF NOT EXISTS memory_impression_evidence_memory ON memory_impression_evidence(memoryId);

-- 同一 (impressionId, memoryId) 只留一行：重建证据链时按新权重覆盖旧行（幂等）。
link:
INSERT OR REPLACE INTO memory_impression_evidence(impressionId, memoryId, weight, createdAt)
VALUES (?, ?, ?, ?);

unlinkByImpression:
DELETE FROM memory_impression_evidence WHERE impressionId = ?;

listForImpression:
SELECT impressionId, memoryId, weight, createdAt
FROM memory_impression_evidence
WHERE impressionId = ?
ORDER BY weight DESC, memoryId ASC;

countForImpression:
SELECT COUNT(*) FROM memory_impression_evidence WHERE impressionId = ?;

-- 记忆已不存在（被物理清理/备份恢复后缺行）的证据保留下来只会让印象显示悬空引用。
deleteOrphans:
DELETE FROM memory_impression_evidence
WHERE NOT EXISTS (SELECT 1 FROM memory_items WHERE memory_items.id = memory_impression_evidence.memoryId);

deleteByMemory:
DELETE FROM memory_impression_evidence WHERE memoryId = ?;

-- T88 备份全量：恢复与计数按 (impressionId, memoryId) 升序读出全部证据行。
selectAllForBackup:
SELECT impressionId, memoryId, weight, createdAt
FROM memory_impression_evidence
ORDER BY impressionId, memoryId;

deleteAllImpressionEvidence:
DELETE FROM memory_impression_evidence;